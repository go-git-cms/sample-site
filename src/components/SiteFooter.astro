---
// The default footer, on every page except the homepage — which composes its
// own from a `footer` block so an editor can change its links without touching
// a template.
import { SITE } from "~/lib/seo";

interface Props {
  tagline?: string;
  links?: { label: string; href: string }[];
}

const { tagline = SITE.description, links = [] } = Astro.props;
const year = new Date().getUTCFullYear();
---

<footer class="border-t mt-24" style="border-color: var(--line-subtle)">
  <div
    class="mx-auto max-w-5xl px-6 py-10 flex flex-col sm:flex-row sm:items-start justify-between gap-6"
  >
    <div class="max-w-md">
      <p class="font-medium">{SITE.name}</p>
      <p class="mt-1 text-sm" style="color: var(--fg-muted)">{tagline}</p>
    </div>
    {
      links.length > 0 && (
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {links.map((l) => (
            <li>
              <a href={l.href} class="hover:opacity-70 transition-opacity" style="color: var(--fg-muted)">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <div class="mx-auto max-w-5xl px-6 pb-10">
    <p class="font-mono text-xs" style="color: var(--fg-faint)">
      © {year} — built with Astro, edited with Go·Git CMS
    </p>
  </div>
</footer>
