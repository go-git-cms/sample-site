---
// Everything that belongs in <head> for one page, from one resolved object.
//
// Structured data is emitted here too rather than per-page: JSON-LD that
// disagrees with the meta tags is worse than no JSON-LD, and the only way to
// guarantee they agree is to build both from the same input.
import { SITE, type ResolvedSeo } from "~/lib/seo";

interface Props {
  seo: ResolvedSeo;
  /** "website" for pages, "article" for articles and projects. */
  type?: "website" | "article";
  /** Article/project timestamps, for the JSON-LD and og: tags. */
  publishedTime?: string;
  modifiedTime?: string;
}

const { seo, type = "website", publishedTime, modifiedTime } = Astro.props;

// Astro.site comes from `site` in astro.config.mjs. Absolute URLs are required
// by Open Graph and strongly preferred for canonicals, so a missing `site` is
// worth failing loudly on rather than emitting relative tags that half work.
const base = Astro.site ?? new URL("http://localhost:4340");
const canonical = seo.canonical || new URL(Astro.url.pathname, base).href;
const image = seo.image ? new URL(seo.image, base).href : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": type === "article" ? "Article" : "WebSite",
  name: seo.title,
  headline: type === "article" ? seo.title : undefined,
  description: seo.description,
  url: canonical,
  image,
  datePublished: publishedTime,
  dateModified: modifiedTime || publishedTime,
  author: { "@type": "Person", name: SITE.name },
};
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={canonical} />

{seo.keywords && <meta name="keywords" content={seo.keywords.join(", ")} />}
{/* noindex is the one SEO field with teeth — it is how a draft or a private
    project page stays out of search results while still being publicly
    reachable by anyone with the link. */}
{seo.noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.name} />
{image && <meta property="og:image" content={image} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
{SITE.twitter && <meta name="twitter:site" content={SITE.twitter} />}
{image && <meta name="twitter:image" content={image} />}

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd, (_, v) => (v === undefined ? undefined : v))}
/>
