---
import { getCollection } from "astro:content";
import ProjectCard from "~/components/ProjectCard.astro";

interface Props {
  heading?: string;
  intro?: string;
  limit?: number;
}

const { heading = "Selected work", intro, limit = 3 } = Astro.props;

const all = await getCollection("projects");
const featured = all
  .sort((a, b) => {
    const byFlag = Number(b.data.featured ?? false) - Number(a.data.featured ?? false);
    if (byFlag !== 0) return byFlag;
    return (b.data.year ?? 0) - (a.data.year ?? 0);
  })
  .slice(0, limit);
---

{
  featured.length > 0 && (
    <section class="mx-auto max-w-5xl px-6 py-16 border-t" style="border-color: var(--line-subtle)">
      <div class="flex items-baseline justify-between gap-6">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">{heading}</h2>
          {intro && (
            <p class="mt-2 max-w-xl text-pretty" style="color: var(--fg-muted)">
              {intro}
            </p>
          )}
        </div>
        <a href="/projects/" class="text-sm shrink-0 hover:opacity-70 transition-opacity">
          All projects →
        </a>
      </div>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p) => (
          <ProjectCard
            title={p.data.title}
            slug={p.data.slug}
            summary={p.data.summary}
            year={p.data.year}
            role={p.data.role}
            status={p.data.status}
            tags={p.data.tags}
            thumbnail={p.data.thumbnail}
          />
        ))}
      </div>
    </section>
  )
}
