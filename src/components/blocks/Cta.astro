---
// The CTA block is shared: the homepage and every project page render this same
// component, because both alias the same `&ctaBlock` variant in go-git-cms.yml.
// One schema, one template — the two surfaces cannot drift.
interface Props {
  heading: string;
  body?: string;
  buttonLabel?: string;
  buttonHref?: string;
}

const { heading, body, buttonLabel, buttonHref } = Astro.props;
---

<section class="mx-auto max-w-5xl px-6 py-16">
  <div
    class="rounded-md border px-8 py-12 text-center"
    style="border-color: var(--line); background: var(--sunken)"
  >
    <h2 class="text-2xl font-semibold tracking-tight text-balance">{heading}</h2>
    {
      body && (
        <p class="mt-3 mx-auto max-w-lg text-pretty" style="color: var(--fg-muted)">
          {body}
        </p>
      )
    }
    {
      buttonLabel && buttonHref && (
        <a
          href={buttonHref}
          class="mt-7 inline-flex items-center h-10 px-6 rounded-md text-sm font-medium transition-opacity hover:opacity-85"
          style="background: var(--fg); color: var(--page)"
        >
          {buttonLabel}
        </a>
      )
    }
  </div>
</section>
