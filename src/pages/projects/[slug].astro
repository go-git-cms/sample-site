---
import { marked } from "marked";
import Base from "~/layouts/Base.astro";
import BlockRenderer from "~/components/BlockRenderer.astro";
import { getProject } from "~/lib/content";
import { mediaUrl, resolveSeo } from "~/lib/seo";

// Routed on the `slug` field — see the note in articles/[slug].astro.
const project = await getProject(Astro.params.slug ?? "", Astro.locals.preview);
if (!project) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

// A project page is composed of blocks *and* has a Markdown body for closing
// notes. Both are optional, so the page renders whichever exist.
const html = await marked.parse(project.body);

const STATUS: Record<string, string> = {
  "in-progress": "In progress",
  shipped: "Shipped",
  archived: "Archived",
};

const thumbSrc = mediaUrl(project.thumbnail);

const seo = resolveSeo(project.seo, {
  title: project.title,
  description: project.summary,
  image: project.thumbnail,
});
---

<Base seo={seo} type="article">
  <article>
    <header class="mx-auto max-w-3xl px-6 pt-16">
      <a href="/projects/" class="font-mono text-xs hover:opacity-70" style="color: var(--fg-faint)">
        ← Projects
      </a>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-balance">
        {project.title}
      </h1>
      {
        project.summary && (
          <p class="mt-4 text-lg text-pretty" style="color: var(--fg-muted)">
            {project.summary}
          </p>
        )
      }

      {/* The structured metadata, as a definition list — it is data about the
          project, not decoration, so it gets markup that says so. */}
      <dl class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-6 py-6 border-y" style="border-color: var(--line-subtle)">
        {
          project.year && (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-widest" style="color: var(--fg-faint)">Year</dt>
              <dd class="mt-1 text-sm">{project.year}</dd>
            </div>
          )
        }
        {
          project.role && (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-widest" style="color: var(--fg-faint)">Role</dt>
              <dd class="mt-1 text-sm">{project.role}</dd>
            </div>
          )
        }
        {
          project.status && (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-widest" style="color: var(--fg-faint)">Status</dt>
              <dd class="mt-1 text-sm">{STATUS[project.status]}</dd>
            </div>
          )
        }
        {
          project.url && (
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-widest" style="color: var(--fg-faint)">Live</dt>
              <dd class="mt-1 text-sm">
                <a
                  href={project.url}
                  rel="noopener noreferrer"
                  target="_blank"
                  class="underline underline-offset-4"
                >
                  Visit ↗
                </a>
              </dd>
            </div>
          )
        }
      </dl>

      {
        project.tags && project.tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {project.tags.map((t) => (
              <li
                class="font-mono text-[11px] px-2 py-0.5 rounded border"
                style="border-color: var(--line-subtle); color: var(--fg-faint)"
              >
                {t}
              </li>
            ))}
          </ul>
        )
      }

      {
        thumbSrc && (
          <img
            src={thumbSrc}
            alt=""
            class="mt-10 w-full aspect-[16/10] object-cover rounded-md border"
            style="border-color: var(--line-subtle)"
          />
        )
      }
    </header>

    <BlockRenderer blocks={project.blocks} />

    <div class="mx-auto max-w-3xl px-6 pb-16">
      <div class="prose" set:html={html} />
    </div>
  </article>
</Base>
