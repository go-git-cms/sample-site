---
import { formatDate, mediaUrl, type MediaRef } from "~/lib/seo";

interface Props {
  title: string;
  slug: string;
  excerpt?: string;
  publishDate?: Date;
  tags?: string[];
  cover?: MediaRef;
}

const { title, slug, excerpt, publishDate, tags = [], cover } = Astro.props;
const date = formatDate(publishDate);
const coverSrc = mediaUrl(cover);
---

<article class="group">
  <a href={`/articles/${slug}/`} class="block">
    {
      coverSrc && (
        <img
          src={coverSrc}
          alt=""
          loading="lazy"
          class="mb-4 w-full aspect-[16/9] object-cover rounded-md border"
          style="border-color: var(--line-subtle)"
        />
      )
    }
    {
      date.iso && (
        <time datetime={date.iso} class="font-mono text-xs" style="color: var(--fg-faint)">
          {date.label}
        </time>
      )
    }
    <h3 class="mt-1 text-lg font-medium tracking-tight group-hover:opacity-70 transition-opacity">
      {title}
    </h3>
    {
      excerpt && (
        <p class="mt-2 text-sm text-pretty" style="color: var(--fg-muted)">
          {excerpt}
        </p>
      )
    }
  </a>
  {
    tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {tags.map((t) => (
          <li
            class="font-mono text-[11px] px-2 py-0.5 rounded border"
            style="border-color: var(--line-subtle); color: var(--fg-faint)"
          >
            {t}
          </li>
        ))}
      </ul>
    )
  }
</article>
