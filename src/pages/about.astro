---
import { marked } from "marked";
import Base from "~/layouts/Base.astro";
import { getAbout } from "~/lib/content";
import { mediaUrl, resolveSeo } from "~/lib/seo";

// The one page that is prose rather than blocks. An about page is an essay, and
// pushing it through a block builder would make it harder to write, not easier.
const about = await getAbout(Astro.locals.preview);

const html = await marked.parse(about.body);
const portraitSrc = mediaUrl(about.portrait);

const seo = resolveSeo(about.seo, {
  title: about.title,
  description: about.intro,
  image: about.portrait,
});
---

<Base seo={seo}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <header class="flex flex-col-reverse sm:flex-row sm:items-start gap-8">
      <div class="flex-1">
        <h1 class="text-4xl font-semibold tracking-tight text-balance">{about.title}</h1>
        {
          about.intro && (
            <p class="mt-4 text-lg text-pretty" style="color: var(--fg-muted)">
              {about.intro}
            </p>
          )
        }
      </div>
      {
        portraitSrc && (
          <img
            src={portraitSrc}
            alt=""
            width="128"
            height="128"
            class="w-28 h-28 rounded-md object-cover border shrink-0"
            style="border-color: var(--line-subtle)"
          />
        )
      }
    </header>

    <div class="prose mt-12" set:html={html} />
  </div>
</Base>
