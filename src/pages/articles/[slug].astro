---
import { marked } from "marked";
import Base from "~/layouts/Base.astro";
import ArticleCard from "~/components/ArticleCard.astro";
import NewsletterSignup from "~/components/NewsletterSignup.astro";
import { getArticle, getRelated } from "~/lib/content";
import { formatDate, mediaUrl, resolveSeo } from "~/lib/seo";

// Routed on the `slug` *field*, not the filename. The slug is what an editor
// controls and what the CMS's preview URL template interpolates, so the two
// have to agree — route on the filename and every preview lands on a 404 the
// moment someone renames a post's title without renaming its file.
// Server-rendered per request: the page already composes preview drafts, and
// the newsletter signup reads the query string a no-JavaScript submission
// redirects back with.
export const prerender = false;

const preview = Astro.locals.preview;
const article = await getArticle(Astro.params.slug ?? "", preview);

// Parity with the old static build: a draft has no public URL. In preview the
// editor must still see it — the draft flag is one of the things being edited.
if (!article || (article.draft && !preview)) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

const html = await marked.parse(article.body);

// What the author listed as related, resolved from their keys. Nothing about a
// target is copied into this article's file — the reference is a pointer — so
// a retitled article shows its new title here without this one being rewritten.
const related = await getRelated(article, preview);

const published = formatDate(article.publishDate);
const updated = formatDate(article.updateDate);
const coverSrc = mediaUrl(article.cover);

const seo = resolveSeo(article.seo, {
  title: article.title,
  description: article.excerpt,
  image: article.cover,
});
---

<Base
  seo={seo}
  type="article"
  publishedTime={published.iso}
  modifiedTime={updated.iso || undefined}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <header>
      <a href="/articles/" class="font-mono text-xs hover:opacity-70" style="color: var(--fg-faint)">
        ← Articles
      </a>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-balance">
        {article.title}
      </h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 font-mono text-xs" style="color: var(--fg-faint)">
        {published.iso && <time datetime={published.iso}>{published.label}</time>}
        {updated.iso && <span>· updated {updated.label}</span>}
      </div>
      {
        article.tags && article.tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {article.tags.map((t) => (
              <li
                class="font-mono text-[11px] px-2 py-0.5 rounded border"
                style="border-color: var(--line-subtle); color: var(--fg-faint)"
              >
                {t}
              </li>
            ))}
          </ul>
        )
      }
      {
        coverSrc && (
          <img
            src={coverSrc}
            alt=""
            class="mt-10 w-full aspect-[16/9] object-cover rounded-md border"
            style="border-color: var(--line-subtle)"
          />
        )
      }
    </header>

    <div class="prose mt-10" set:html={html} />

    {
      related.length > 0 && (
        <section class="mt-16 pt-10 border-t" style="border-color: var(--line-subtle)">
          <h2 class="text-xl font-semibold tracking-tight">Related reading</h2>
          <div class="mt-8 grid gap-10 sm:grid-cols-2">
            {related.map((a) => (
              <ArticleCard
                title={a.title}
                slug={a.slug}
                excerpt={a.excerpt}
                publishDate={a.publishDate}
                tags={a.tags}
                cover={a.cover}
              />
            ))}
          </div>
        </section>
      )
    }

    {/* The signup reads ?subscribed / ?subscribeError from the no-JavaScript
        round trip, which is why this page is server-rendered below. */}
    <NewsletterSignup />
  </article>
</Base>
