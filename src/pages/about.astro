---
import { getEntry, render } from "astro:content";
import Base from "~/layouts/Base.astro";
import { mediaUrl, resolveSeo } from "~/lib/seo";

// The one page that is prose rather than blocks. An about page is an essay, and
// pushing it through a block builder would make it harder to write, not easier.
const about = await getEntry("about", "about");
if (!about) {
  throw new Error("src/content/pages/about.md is missing — About is a singleton and must exist.");
}

const { Content } = await render(about);
const portraitSrc = mediaUrl(about.data.portrait);

const seo = resolveSeo(about.data.seo, {
  title: about.data.title,
  description: about.data.intro,
  image: about.data.portrait,
});
---

<Base seo={seo}>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <header class="flex flex-col-reverse sm:flex-row sm:items-start gap-8">
      <div class="flex-1">
        <h1 class="text-4xl font-semibold tracking-tight text-balance">{about.data.title}</h1>
        {
          about.data.intro && (
            <p class="mt-4 text-lg text-pretty" style="color: var(--fg-muted)">
              {about.data.intro}
            </p>
          )
        }
      </div>
      {
        portraitSrc && (
          <img
            src={portraitSrc}
            alt=""
            width="128"
            height="128"
            class="w-28 h-28 rounded-md object-cover border shrink-0"
            style="border-color: var(--line-subtle)"
          />
        )
      }
    </header>

    <div class="prose mt-12">
      <Content />
    </div>
  </div>
</Base>
