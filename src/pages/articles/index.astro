---
import Base from "~/layouts/Base.astro";
import ArticleCard from "~/components/ArticleCard.astro";
import { getArticles } from "~/lib/content";
import { resolveSeo } from "~/lib/seo";

// Drafts are excluded from the listing entirely. `draft: true` in the CMS is
// how an editor keeps a post out of the published site while still saving it to
// the branch — remember that saving already commits, so "unpublished" has to be
// a content decision rather than an unsaved one.
const articles = (await getArticles(Astro.locals.preview))
  .filter((a) => !a.draft)
  .sort((a, b) => b.publishDate.getTime() - a.publishDate.getTime());

const seo = resolveSeo(undefined, {
  title: "Articles",
  description: "Essays and notes.",
});
---

<Base seo={seo}>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight">Articles</h1>
    <p class="mt-2" style="color: var(--fg-muted)">Essays and notes, newest first.</p>

    {
      articles.length === 0 ? (
        <p class="mt-12" style="color: var(--fg-faint)">Nothing published yet.</p>
      ) : (
        <div class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
          {articles.map((a) => (
            <ArticleCard
              title={a.title}
              slug={a.slug}
              excerpt={a.excerpt}
              publishDate={a.publishDate}
              tags={a.tags}
              cover={a.cover}
            />
          ))}
        </div>
      )
    }
  </div>
</Base>
