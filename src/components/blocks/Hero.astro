---
import { mediaUrl, type MediaRef } from "~/lib/seo";

interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  portrait?: MediaRef;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow,
  heading,
  subheading,
  portrait,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;

const portraitSrc = mediaUrl(portrait);
---

<section class="mx-auto max-w-5xl px-6 pt-20 pb-16">
  <div class="flex flex-col-reverse md:flex-row md:items-center gap-12">
    <div class="flex-1">
      {
        eyebrow && (
          <p class="font-mono text-xs uppercase tracking-widest" style="color: var(--fg-faint)">
            {eyebrow}
          </p>
        )
      }
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight text-balance">
        {heading}
      </h1>
      {
        subheading && (
          <p class="mt-5 text-lg max-w-xl text-pretty" style="color: var(--fg-muted)">
            {subheading}
          </p>
        )
      }
      {
        (primaryLabel || secondaryLabel) && (
          <div class="mt-8 flex flex-wrap gap-3">
            {primaryLabel && primaryHref && (
              <a
                href={primaryHref}
                class="inline-flex items-center h-10 px-5 rounded-md text-sm font-medium transition-opacity hover:opacity-85"
                style="background: var(--fg); color: var(--page)"
              >
                {primaryLabel}
              </a>
            )}
            {secondaryLabel && secondaryHref && (
              <a
                href={secondaryHref}
                class="inline-flex items-center h-10 px-5 rounded-md border text-sm font-medium transition-colors"
                style="border-color: var(--line)"
              >
                {secondaryLabel}
              </a>
            )}
          </div>
        )
      }
    </div>
    {
      portraitSrc && (
        <div class="shrink-0">
          <img
            src={portraitSrc}
            alt=""
            width="200"
            height="200"
            class="w-40 h-40 md:w-52 md:h-52 rounded-md object-cover border"
            style="border-color: var(--line-subtle)"
          />
        </div>
      )
    }
  </div>
</section>
