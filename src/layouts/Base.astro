---
import Seo from "~/components/Seo.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import type { ResolvedSeo } from "~/lib/seo";
import "~/styles/global.css";

interface Props {
  seo: ResolvedSeo;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  /** The homepage renders its own footer block, so it opts out of the default. */
  footer?: boolean;
}

const { seo, type, publishedTime, modifiedTime, footer = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Articles" href="/rss.xml" />
    <Seo seo={seo} type={type} publishedTime={publishedTime} modifiedTime={modifiedTime} />
  </head>
  <body class="min-h-screen flex flex-col">
    <SiteHeader />
    <main class="flex-1">
      <slot />
    </main>
    {footer && <SiteFooter />}
  </body>
</html>
