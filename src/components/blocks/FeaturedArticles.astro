---
import ArticleCard from "~/components/ArticleCard.astro";
import { getArticles } from "~/lib/content";

interface Props {
  heading?: string;
  intro?: string;
  limit?: number;
}

const { heading = "Writing", intro, limit = 3 } = Astro.props;

// The block says how many to show; which ones is the content's decision, taken
// from `featured` and then recency. An editor who wants a specific post on the
// homepage flags the post, rather than maintaining a second list here that can
// go stale when the post is renamed.
const all = (await getArticles(Astro.locals.preview)).filter((a) => !a.draft);
const featured = all
  .sort((a, b) => {
    const byFlag = Number(b.featured) - Number(a.featured);
    if (byFlag !== 0) return byFlag;
    return b.publishDate.getTime() - a.publishDate.getTime();
  })
  .slice(0, limit);
---

{
  featured.length > 0 && (
    <section class="mx-auto max-w-5xl px-6 py-16 border-t" style="border-color: var(--line-subtle)">
      <div class="flex items-baseline justify-between gap-6">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">{heading}</h2>
          {intro && (
            <p class="mt-2 max-w-xl text-pretty" style="color: var(--fg-muted)">
              {intro}
            </p>
          )}
        </div>
        <a href="/articles/" class="text-sm shrink-0 hover:opacity-70 transition-opacity">
          All articles →
        </a>
      </div>
      <div class="mt-8 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((a) => (
          <ArticleCard
            title={a.title}
            slug={a.slug}
            excerpt={a.excerpt}
            publishDate={a.publishDate}
            tags={a.tags}
            cover={a.cover}
          />
        ))}
      </div>
    </section>
  )
}
