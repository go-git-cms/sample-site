---
import { mediaUrl, type MediaRef } from "~/lib/seo";

interface Props {
  title: string;
  slug: string;
  summary?: string;
  year?: number;
  role?: string;
  status?: "in-progress" | "shipped" | "archived";
  tags?: string[];
  thumbnail?: MediaRef;
}

const { title, slug, summary, year, role, status, tags = [], thumbnail } = Astro.props;
const thumbSrc = mediaUrl(thumbnail);

// The status label is the one place a project's state is spelled out. Rendering
// the raw enum value ("in-progress") would leak the schema into the page.
const STATUS: Record<string, string> = {
  "in-progress": "In progress",
  shipped: "Shipped",
  archived: "Archived",
};
---

<article class="group border rounded-md overflow-hidden" style="border-color: var(--line-subtle)">
  <a href={`/projects/${slug}/`} class="block">
    {
      thumbSrc && (
        <img
          src={thumbSrc}
          alt=""
          loading="lazy"
          class="w-full aspect-[16/10] object-cover"
        />
      )
    }
    <div class="p-5">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="text-lg font-medium tracking-tight group-hover:opacity-70 transition-opacity">
          {title}
        </h3>
        {
          year && (
            <span class="font-mono text-xs shrink-0" style="color: var(--fg-faint)">
              {year}
            </span>
          )
        }
      </div>
      {
        (role || status) && (
          <p class="mt-1 font-mono text-xs" style="color: var(--fg-faint)">
            {[role, status && STATUS[status]].filter(Boolean).join(" · ")}
          </p>
        )
      }
      {
        summary && (
          <p class="mt-3 text-sm text-pretty" style="color: var(--fg-muted)">
            {summary}
          </p>
        )
      }
      {
        tags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {tags.map((t) => (
              <li
                class="font-mono text-[11px] px-2 py-0.5 rounded border"
                style="border-color: var(--line-subtle); color: var(--fg-faint)"
              >
                {t}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </a>
</article>
