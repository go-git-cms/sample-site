---
import Base from "~/layouts/Base.astro";
import BlockRenderer from "~/components/BlockRenderer.astro";
import { getHome } from "~/lib/content";
import { resolveSeo, SITE } from "~/lib/seo";

// A singleton in the CMS is one file here. It always exists — the model has no
// wildcard in its path, so it cannot be created or deleted, only edited. Read
// per request with the preview draft composed in, so an unsaved edit in the
// editor is what renders in its iframe.
const home = await getHome(Astro.locals.preview);

// No fallback title on purpose: with none, resolveSeo returns SITE.title as-is
// rather than suffixing it, so the homepage is "Ada Lovelace — engineer &
// writer" and not "… · Ada Lovelace".
const seo = resolveSeo(home.seo, { description: SITE.description });

// The footer is one of the homepage's blocks, so the layout's default footer is
// suppressed here to avoid rendering two.
const hasFooterBlock = home.blocks.some((b) => b._variant === "footer");
---

<Base seo={seo} footer={!hasFooterBlock}>
  <BlockRenderer blocks={home.blocks} />
</Base>
