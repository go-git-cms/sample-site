# Caddy fronts the sample-site container. The site is `output: "server"`
# (astro.config.mjs) — a Node process renders pages per request so the preview
# middleware can compose an unsaved CMS draft over the content files — and
# Caddy serves what is genuinely static off disk: the hashed /_astro bundles,
# public/ files, and the self-hosted editor at /admin/ when the image was built
# with GITCMS_API_URL. Everything else proxies to Node on ASTRO_PORT.
#
# The platform terminates TLS at its edge, so this listens on plain HTTP on
# $PORT and does not ask for a certificate — `auto_https off` stops Caddy trying
# to solve an ACME challenge for a hostname it doesn't control. Running it
# locally is the same shape, which is the point: one config, no
# environment-conditional blocks.

{
	auto_https off
	admin off
	# The platform already logs the request; Caddy repeating it doubles the
	# volume.
	log {
		output stderr
		format console
		level ERROR
	}
}

:{$PORT:8080} {
	encode zstd gzip

	# Headers every response shares. Two things are deliberately NOT here:
	#
	#   Content-Security-Policy — the site and the editor need different
	#   policies, and a site-wide header would stack with a per-handle one:
	#   browsers enforce the intersection of multiple CSP headers, which would
	#   silently break /admin. Each handle below sets its own instead.
	#
	#   X-Frame-Options — the preview middleware renders draft pages inside the
	#   CMS editor's iframe, and a blanket DENY would blank that pane. Framing
	#   is governed per-handle by each CSP's frame-ancestors instead, which is
	#   both more precise and what browsers prefer when the two disagree.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Answered by Caddy itself, for the platform's health check. `handle`, not a
	# bare `respond /healthz`: Caddy sorts directives by its own order, and every
	# `handle` in a site is one mutually exclusive group evaluated together — a
	# bare `respond` would sit behind the catch-all below. As a sibling handle it
	# wins on the more specific matcher.
	handle /healthz {
		respond "ok" 200
	}

	# The self-hosted editor: a SPA whose static files Astro copied out of
	# public/admin into dist/client. An image built without GITCMS_API_URL has no
	# /admin directory, so the try_files fallback finds nothing and this whole
	# block answers 404 — which is correct there.
	@admin path /admin /admin/*
	handle @admin {
		root * /app/dist/client

		# The editor's own policy, and the reason CSP is per-handle. Same shape
		# as the docs/website policies minus their PostHog hosts: the bundle and
		# its inline bootstrap need script-src 'self' 'unsafe-inline'; the font
		# stylesheet in its index.html is Google's; GraphQL goes to the CMS API
		# origin and live collaboration to its ws form, which must be listed
		# separately because a CSP source matches on scheme. Both are derived by
		# docker-entrypoint.sh from GITCMS_API_URL (or set explicitly as
		# CMS_API_ORIGIN / CMS_COLLAB_ORIGIN). CMS_PREVIEW_ORIGIN — derived from
		# CMS_PREVIEW_SERVER, and empty when preview points at this same origin —
		# appears twice because the Preview pane uses the site two ways: the
		# entry-route fetch is connect-src, and the preview itself is an iframe
		# of a page on that origin — frame-src, which otherwise inherits
		# default-src and leaves the pane blank. A deployment that stores media
		# off-origin needs that origin in img-src too, or thumbnails vanish.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' {$CMS_API_ORIGIN:} {$CMS_WS_ORIGINS:} {$CMS_PREVIEW_ORIGIN:}; frame-src 'self' {$CMS_PREVIEW_ORIGIN:}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		# gitcms-ide emits app.js/app.css under deliberately stable names, so
		# the HTML references them as app.js?v=<content hash> (stamp-admin.mjs)
		# and the shell itself must never be cached — a cached index.html keeps
		# pointing at the previous build's ?v= and the editor silently stays on
		# the old bundle's baked-in API URL and ids. The stamped URLs make the
		# assets themselves immutable: new bytes, new URL.
		@editorAssets path /admin/app.js /admin/app.css
		header @editorAssets Cache-Control "public, max-age=31536000, immutable"
		@editorShell not path /admin/app.js /admin/app.css
		header @editorShell Cache-Control "no-store"

		# The SPA's router writes real paths under /admin/, so anything that is
		# not a file on disk is a client-side route and gets the shell.
		try_files {path} {path}/ /admin/index.html
		file_server
	}

	# Everything from here down is the site itself, which ships no JavaScript at
	# all — the only <script> tags Astro renders are application/ld+json, which
	# the browser treats as data — and no external fonts or third-party
	# anything. script-src is therefore deliberately absent, falling back to
	# default-src 'none'. The allowances are real: templates set inline style=""
	# attributes (accent colours, muted text), hence 'unsafe-inline' in
	# style-src; media fields resolve to /images on this origin, hence img-src
	# 'self'. A deployment that moves media to a CDN (the object form's
	# cdn_path, which src/lib/seo.ts#mediaUrl prefers) must add that origin to
	# img-src or every picture disappears.
	#
	# frame-ancestors is 'self' rather than 'none': the CMS editor's Preview
	# pane iframes these pages — that is the whole point of the SSR middleware —
	# and the /admin editor is same-origin. An editor hosted elsewhere goes in
	# CMS_EDITOR_ORIGINS (space-separated origins), which the entrypoint passes
	# through.

	# Astro emits its bundles under /_astro with hashed filenames, so they are
	# immutable by construction and never need revalidating.
	handle /_astro/* {
		root * /app/dist/client
		header Content-Security-Policy "default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Real files in dist/client (favicon, robots' static sibling, /images/*) are
	# served if they exist; everything else falls through to the SSR render.
	handle {
		root * /app/dist/client
		header Content-Security-Policy "default-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'self' {$CMS_EDITOR_ORIGINS:}; base-uri 'none'; form-action 'none'"

		# `route` is what makes the fallthrough work, and it is not decoration:
		# Caddy's default directive order puts reverse_proxy *before*
		# file_server, so written plainly in this block the proxy answered first
		# and `pass_thru` never ran — every static file in dist/client was being
		# rendered by Node, which is the one thing this container puts Caddy in
		# front of it to avoid. `route` keeps the order written here.
		route {
			file_server {
				pass_thru
			}
			reverse_proxy 127.0.0.1:{$ASTRO_PORT:4321} {
				# The site builds absolute URLs (canonicals, the RSS feed) and
				# the preview middleware reads forwarded headers, so Node needs
				# to know it is behind a proxy on https.
				header_up X-Forwarded-Proto {scheme}
				header_up X-Forwarded-Host {host}
			}
		}
	}
}
